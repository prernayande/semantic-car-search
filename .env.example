# Copy to .env (gitignored). These match the local database from docker-compose.yml.
DATABASE_URL=jdbc:postgresql://localhost:5433/cars
DATABASE_USER=cars
DATABASE_PASSWORD=change-me

# Neon (production). Neon -> Connect, with connection pooling OFF (hostname without "-pooler").
# Split its postgresql://USER:PASSWORD@HOST/DB?sslmode=require into the three values below, and drop
# "channel_binding=require" if present:
# DATABASE_URL=jdbc:postgresql://ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# DATABASE_USER=neondb_owner
# DATABASE_PASSWORD=...
